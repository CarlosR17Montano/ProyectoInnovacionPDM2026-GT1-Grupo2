<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_delivery_gradient">

    <LinearLayout
        android:id="@+id/contenedorSolicitudesRepartidor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛵 Solicitudes disponibles"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#D81B60"
            android:gravity="center"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona una solicitud para aceptarla"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#4A148C"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnRefrescarSolicitudes"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Actualizar solicitudes"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#333333"
            android:background="@drawable/bg_button_yellow"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/layoutSolicitudesDisponibles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnVolverSolicitudes"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Volver"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_dark_pink"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</ScrollView>