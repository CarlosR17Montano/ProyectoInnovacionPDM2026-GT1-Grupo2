<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_delivery_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Encabezado -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛵 Panel del Repartidor"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#D81B60"
            android:gravity="center"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gestiona tus entregas asignadas"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#4A148C"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnVerSolicitudesDisponibles"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Ver solicitudes disponibles"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#333333"
            android:background="@drawable/bg_button_yellow"
            android:layout_marginBottom="18dp" />

        <!-- Tarjeta del pedido -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_login"
            android:elevation="8dp"
            android:padding="22dp"
            android:layout_marginBottom="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pedido asignado"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/txtCodigoPedidoRepartidor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Código: Sin pedido"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:background="@drawable/bg_input_accesible"
                android:padding="10dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txtClienteRepartidor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cliente: No asignado"
                android:textSize="17sp"
                android:textColor="#333333"
                android:background="@drawable/bg_input_accesible"
                android:padding="10dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txtDireccionRepartidor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dirección: No asignada"
                android:textSize="17sp"
                android:textColor="#333333"
                android:background="@drawable/bg_input_accesible"
                android:padding="10dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txtEstadoRepartidor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estado: Selecciona una solicitud disponible"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#D81B60"
                android:background="@drawable/bg_input_accesible"
                android:padding="10dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txtGananciaRepartidor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ganancia estimada: $0.00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#4A148C"
                android:background="@drawable/bg_input_accesible"
                android:padding="10dp" />

        </LinearLayout>

        <!-- Flujo real del repartidor -->
        <Button
            android:id="@+id/btnIrRecogerPaquete"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Ir a recoger paquete"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_pink"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnLleguePuntoRecogida"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Llegué al punto de recogida"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#333333"
            android:background="@drawable/bg_button_yellow"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnConfirmarPaqueteRecogido"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Confirmar paquete recogido"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_dark_pink"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnIniciarRutaEntrega"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Iniciar ruta de entrega"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_pink"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnActualizarUbicacion"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Actualizar ubicación GPS"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#333333"
            android:background="@drawable/bg_button_yellow"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnTomarEvidencia"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Registrar evidencia de entrega"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_dark_pink"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnFinalizarEntrega"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Finalizar solicitud"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_pink"
            android:layout_marginBottom="24dp" />

    </LinearLayout>

</ScrollView>