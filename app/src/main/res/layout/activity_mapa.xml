<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_delivery_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Título principal de seguimiento -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗺️ Seguimiento GPS"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#D81B60"
            android:gravity="center"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp" />

        <!-- Descripción breve -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ubicación actual del repartidor"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#4A148C"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Contenedor real de Google Maps -->
        <fragment
            android:id="@+id/mapaEntrega"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="390dp"
            android:layout_marginBottom="22dp" />

        <!-- Tarjeta de datos GPS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_login"
            android:elevation="8dp"
            android:padding="20dp"
            android:layout_marginBottom="22dp">

            <!-- Estado de ubicación -->
            <TextView
                android:id="@+id/txtEstadoMapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estado: Repartidor en ruta"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#D81B60"
                android:layout_marginBottom="10dp" />

            <!-- Latitud visible -->
            <TextView
                android:id="@+id/txtLatitudMapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Latitud: 13.6420"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:background="@drawable/bg_input_accesible"
                android:padding="10dp"
                android:layout_marginBottom="8dp" />

            <!-- Longitud visible -->
            <TextView
                android:id="@+id/txtLongitudMapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Longitud: -88.7853"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:background="@drawable/bg_input_accesible"
                android:padding="10dp" />

        </LinearLayout>

        <!-- Botón para simular nueva ubicación -->
        <Button
            android:id="@+id/btnSimularUbicacion"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Actualizar ubicación GPS"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#333333"
            android:background="@drawable/bg_button_yellow"
            android:layout_marginBottom="12dp" />

        <!-- Botón para regresar -->
        <Button
            android:id="@+id/btnVolverMapa"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Volver"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_dark_pink" />

    </LinearLayout>

</ScrollView>