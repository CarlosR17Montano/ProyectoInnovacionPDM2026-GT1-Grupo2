<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_delivery_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Titulo principal de evidencia -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📸 Evidencia de Entrega"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#D81B60"
            android:gravity="center"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp" />

        <!-- Descripcion breve -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Captura fotografica del pedido entregado"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#6A1B9A"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Vista previa real de la camara con CameraX -->
        <androidx.camera.view.PreviewView
            android:id="@+id/previewCamara"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:background="@drawable/bg_card_login"
            android:elevation="8dp"
            android:layout_marginBottom="22dp" />

        <!-- Vista donde se mostrara la foto tomada usando Glide -->
        <ImageView
            android:id="@+id/imgEvidencia"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:background="@drawable/bg_card_login"
            android:elevation="8dp"
            android:contentDescription="Foto de evidencia de entrega"
            android:layout_marginBottom="22dp" />

        <!-- Tarjeta de estado de la evidencia -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_login"
            android:elevation="8dp"
            android:padding="20dp"
            android:layout_marginBottom="22dp">

            <!-- Estado actual -->
            <TextView
                android:id="@+id/txtEstadoEvidencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estado: Pendiente de evidencia"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#D81B60"
                android:layout_marginBottom="6dp" />

            <!-- Resultado de foto tomada -->
            <TextView
                android:id="@+id/txtRutaFoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Foto: No registrada"
                android:textSize="14sp"
                android:textColor="#777777" />

        </LinearLayout>

        <!-- Boton para capturar foto -->
        <Button
            android:id="@+id/btnTomarFoto"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Tomar foto"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#333333"
            android:background="@drawable/bg_button_yellow"
            android:layout_marginBottom="12dp" />

        <!-- Boton para guardar evidencia -->
        <Button
            android:id="@+id/btnGuardarEvidencia"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Guardar evidencia"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_pink"
            android:layout_marginBottom="12dp" />

        <!-- Boton para regresar -->
        <Button
            android:id="@+id/btnVolverEvidencia"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Volver"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_dark_pink" />

    </LinearLayout>

</ScrollView>