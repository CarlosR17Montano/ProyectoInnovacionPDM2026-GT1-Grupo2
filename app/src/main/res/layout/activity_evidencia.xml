<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_delivery_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Titulo principal de la pantalla -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📸 Evidencia de Entrega"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#D81B60"
            android:gravity="center"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp" />

        <!-- Subtitulo descriptivo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registro fotografico del pedido entregado"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#6A1B9A"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Tarjeta visual donde luego se mostrara la foto real -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card_login"
            android:elevation="8dp"
            android:padding="20dp"
            android:layout_marginBottom="22dp">

            <!-- Icono temporal de camara -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📦📷"
                android:textSize="54sp"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <!-- Texto de espacio reservado -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vista previa de evidencia"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <!-- Explicacion temporal -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aqui se mostrara la fotografia tomada con CameraX"
                android:textSize="15sp"
                android:textColor="#777777"
                android:gravity="center" />

        </LinearLayout>

        <!-- Tarjeta de informacion del pedido -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_login"
            android:elevation="8dp"
            android:padding="20dp"
            android:layout_marginBottom="22dp">

            <!-- Encabezado de datos -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Datos de la evidencia"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="12dp" />

            <!-- Codigo de pedido de prueba -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pedido: PED-001"
                android:textSize="16sp"
                android:textColor="#555555"
                android:layout_marginBottom="6dp" />

            <!-- Estado temporal -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estado: Pendiente de evidencia"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#D81B60"
                android:layout_marginBottom="6dp" />

            <!-- Descripcion funcional -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="La imagen servira como comprobante visual de entrega."
                android:textSize="15sp"
                android:textColor="#777777" />

        </LinearLayout>

        <!-- Boton temporal para abrir camara -->
        <Button
            android:id="@+id/btnTomarFoto"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Tomar foto"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#333333"
            android:background="@drawable/bg_button_yellow"
            android:layout_marginBottom="12dp" />

        <!-- Boton temporal para guardar evidencia -->
        <Button
            android:id="@+id/btnGuardarEvidencia"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Guardar evidencia"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_pink"
            android:layout_marginBottom="12dp" />

        <!-- Boton para regresar -->
        <Button
            android:id="@+id/btnVolverEvidencia"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Volver"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_dark_pink" />

    </LinearLayout>

</ScrollView>