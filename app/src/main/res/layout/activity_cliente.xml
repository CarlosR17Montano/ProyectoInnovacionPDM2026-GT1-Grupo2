<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_delivery_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Título principal -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📦 Detalle del pedido"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#D81B60"
            android:gravity="center"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp" />

        <!-- Subtítulo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seguimiento de tu mandado en tiempo real"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#4A148C"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Tarjeta principal del pedido -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_login"
            android:elevation="8dp"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/txtCodigoPedidoCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pedido:"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/txtTipoServicioCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Servicio:"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txtNombreCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cliente:"
                android:textSize="17sp"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txtTelefonoCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Teléfono:"
                android:textSize="17sp"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txtRepartidorCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Repartidor:"
                android:textSize="17sp"
                android:textColor="#333333" />

        </LinearLayout>

        <!-- Tarjeta de ubicaciones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_login"
            android:elevation="8dp"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/txtDireccionRecogidaCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recoger en:"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/txtDireccionCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Entregar en:"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/txtReferenciaCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Referencia:"
                android:textSize="17sp"
                android:textColor="#333333" />

        </LinearLayout>

        <!-- Tarjeta de mandado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_login"
            android:elevation="8dp"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/txtDescripcionPedidoCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mandado:"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/txtIndicacionesCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Indicaciones:"
                android:textSize="17sp"
                android:textColor="#333333"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/txtDistanciaPrecioCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Distancia y precio:"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#D81B60"
                android:background="@drawable/bg_input_accesible"
                android:padding="12dp" />

        </LinearLayout>

        <!-- Tarjeta de estado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_login"
            android:elevation="8dp"
            android:padding="20dp"
            android:layout_marginBottom="22dp">

            <TextView
                android:id="@+id/txtEstadoCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estado actual:"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#D81B60"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/txtUltimaActualizacionCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Última actualización:"
                android:textSize="16sp"
                android:textColor="#333333"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/txtEvidenciaCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Evidencia registrada:"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#4A148C" />

        </LinearLayout>

        <!-- Botón para ver mapa -->
        <Button
            android:id="@+id/btnVerUbicacion"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Ver ubicación del repartidor"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#333333"
            android:background="@drawable/bg_button_yellow"
            android:layout_marginBottom="12dp" />

        <!-- Botón para ver evidencia -->
        <Button
            android:id="@+id/btnVerEvidencia"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Ver evidencia de entrega"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_pink"
            android:layout_marginBottom="12dp" />

        <!-- Botón volver -->
        <Button
            android:id="@+id/btnVolverHistorialCliente"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Volver a mis pedidos"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_dark_pink" />

    </LinearLayout>

</ScrollView>