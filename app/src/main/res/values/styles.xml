<resources>

    <!-- Estilo general para campos de texto accesibles -->
    <style name="EntregaTrackInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textColor">#212121</item>
        <item name="android:textColorHint">#616161</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@drawable/bg_input_accesible</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <!-- Estilo para campos largos como descripción e indicaciones -->
    <style name="EntregaTrackInputMultiline">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">130dp</item>
        <item name="android:textColor">#212121</item>
        <item name="android:textColorHint">#616161</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">top</item>
        <item name="android:background">@drawable/bg_input_accesible</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <!-- Texto informativo legible -->
    <style name="EntregaTrackTextInfo">
        <item name="android:textColor">#333333</item>
        <item name="android:textSize">16sp</item>
    </style>

</resources>